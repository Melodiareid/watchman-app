import { createClient } from 'jsr:@supabase/supabase-js@2'

const corsHeaders = {
  'Access-Control-Allow-Origin': '*',
  'Access-Control-Allow-Headers': 'authorization, x-client-info, apikey, content-type',
}

Deno.serve(async (req) => {
  if (req.method === 'OPTIONS') {
    return new Response('ok', { headers: corsHeaders })
  }

  try {
    const { bolo_id, creator_token } = await req.json()

    if (!bolo_id || !creator_token) {
      return new Response(
        JSON.stringify({ error: 'Missing bolo_id or creator_token' }),
        { status: 400, headers: { ...corsHeaders, 'Content-Type': 'application/json' } }
      )
    }

    const supabaseAdmin = createClient(
      Deno.env.get('SUPABASE_URL') ?? '',
      Deno.env.get('SUPABASE_SERVICE_ROLE_KEY') ?? ''
    )

    // Confirm the token matches this BOLO's real creator_token
    const { data: bolo, error: boloError } = await supabaseAdmin
      .from('bolos')
      .select('creator_token')
      .eq('id', bolo_id)
      .single()

    if (boloError || !bolo) {
      return new Response(
        JSON.stringify({ error: 'BOLO not found' }),
        { status: 404, headers: { ...corsHeaders, 'Content-Type': 'application/json' } }
      )
    }

    if (bolo.creator_token !== creator_token) {
      return new Response(
        JSON.stringify({ error: 'Unauthorized' }),
        { status: 403, headers: { ...corsHeaders, 'Content-Type': 'application/json' } }
      )
    }

    // Token matches — return sighting locations for this BOLO
    const { data: sightings, error: sightingsError } = await supabaseAdmin
      .from('sightings')
      .select('id, latitude, longitude, area, created_at')
      .eq('bolo_id', bolo_id)

    if (sightingsError) {
      return new Response(
        JSON.stringify({ error: sightingsError.message }),
        { status: 500, headers: { ...corsHeaders, 'Content-Type': 'application/json' } }
      )
    }

    return new Response(
      JSON.stringify({ sightings }),
      { status: 200, headers: { ...corsHeaders, 'Content-Type': 'application/json' } }
    )
  } catch (err) {
    return new Response(
      JSON.stringify({ error: err.message }),
      { status: 500, headers: { ...corsHeaders, 'Content-Type': 'application/json' } }
    )
  }
})